{
  "name": "PortfoliOS Mobile",
  "short_name": "PortfoliOS",
  "description": "A browser-native mobile operating experience for the Bl4ut0 portfolio network.",
  "id": "/?view=mobile",
  "start_url": "/?view=mobile",
  "scope": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#080b12",
  "theme_color": "#080b12",
  "icons": [
    {
      "src": "/mobile/mobile-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/mobile/mobile-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/mobile/mobile-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/mobile/mobile-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Mobile",
      "short_name": "Mobile",
      "url": "/?view=mobile",
      "icons": [{ "src": "/mobile/mobile-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Quick Data",
      "short_name": "Quick",
      "url": "/?view=quick"
    },
    {
      "name": "Desktop",
      "short_name": "Desktop",
      "url": "/?view=desktop"
    }
  ]
}
