<Files "remote.php">
    <IfModule mod_headers.c>
        # Avoid duplicate PHP and Apache response headers.
        Header onsuccess unset Cross-Origin-Opener-Policy
        Header onsuccess unset Cross-Origin-Embedder-Policy
        Header onsuccess unset Referrer-Policy
        Header onsuccess unset Cache-Control
        Header onsuccess unset Content-Security-Policy
        Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
        Header always set Cross-Origin-Embedder-Policy "unsafe-none"
        Header always set Referrer-Policy "no-referrer"
        Header always set Cache-Control "no-store"
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; connect-src https: wss:; frame-src https://*.hyperbeam.com; img-src 'self' data: https:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'"
    </IfModule>
</Files>
<Files "hyperbeam-lib.php">
    Require all denied
</Files>
