{
  "manifest_version": 3,
  "name": "PortfoliOS Native Relay",
  "version": "1.2.0",
  "description": "Native UDP/TCP/HTTP & Windows CLI bridge for PortfoliOS apps. Scoped to os.bl4ut0.dev.",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "*://os.bl4ut0.dev/*",
    "*://os.bl4ut0.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://os.bl4ut0.dev/*",
        "*://os.bl4ut0.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage-bridge.js"],
      "matches": [
        "*://os.bl4ut0.dev/*",
        "*://os.bl4ut0.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    }
  ],
  "action": {
    "default_title": "PortfoliOS Native Relay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "relay@os.bl4ut0.dev",
      "strict_min_version": "109.0"
    }
  }
}
