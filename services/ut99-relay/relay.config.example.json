{
  "listen": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "allowedOrigins": [
    "https://os.bl4ut0.dev",
    "http://localhost:4173"
  ],
  "tokenSecretEnv": "UT99_RELAY_TOKEN_SECRET",
